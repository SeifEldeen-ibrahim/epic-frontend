{
  "components": {
    "schemas": {
      "CallStatusResponse": {
        "properties": {
          "end_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Reason"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "status": {
            "enum": [
              "live",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "outcome",
          "end_reason"
        ],
        "title": "CallStatusResponse",
        "type": "object"
      },
      "CallUnavailable": {
        "properties": {
          "reason": {
            "enum": [
              "capacity",
              "unavailable"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "CallUnavailable",
        "type": "object"
      },
      "CreateCallRequest": {
        "properties": {
          "sdp": {
            "description": "The browser's WebRTC SDP offer.",
            "maxLength": 16384,
            "title": "Sdp",
            "type": "string"
          },
          "tester": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9 _.\\-]{1,40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional tester pseudonym from ?tester=.",
            "title": "Tester"
          }
        },
        "required": [
          "sdp"
        ],
        "title": "CreateCallRequest",
        "type": "object"
      },
      "CreateCallResponse": {
        "properties": {
          "call_id": {
            "format": "uuid",
            "title": "Call Id",
            "type": "string"
          },
          "call_secret": {
            "description": "Send back as X-Call-Secret. Shown once.",
            "title": "Call Secret",
            "type": "string"
          },
          "max_call_seconds": {
            "title": "Max Call Seconds",
            "type": "integer"
          },
          "sdp_answer": {
            "title": "Sdp Answer",
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "call_secret",
          "sdp_answer",
          "max_call_seconds"
        ],
        "title": "CreateCallResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "storage": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Storage",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "storage"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "NotFoundResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NotFoundResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EPIC Voice Agent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/calls": {
      "post": {
        "operationId": "createCall",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCallResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallUnavailable"
                }
              }
            },
            "description": "A cap is reached or the voice service is unavailable."
          }
        },
        "summary": "Start a call (public; budget-capped)",
        "tags": [
          "calls"
        ]
      }
    },
    "/api/calls/{call_id}": {
      "get": {
        "operationId": "getCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Call Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Call-Secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Call-Secret"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            },
            "description": "No such call."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Call state and end reason",
        "tags": [
          "calls"
        ]
      }
    },
    "/api/calls/{call_id}/end": {
      "post": {
        "operationId": "endCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Call Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Call-Secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Call-Secret"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            },
            "description": "No such call."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "End a call (caller hang-up)",
        "tags": [
          "calls"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database and storage are reachable."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "At least one dependency is unreachable (degraded)."
          }
        },
        "summary": "Service health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
